# Local development (docker-compose / `make run-local`). Copy to .env. Never commit real secrets.
CONVOIQ_ENV=local
CONVOIQ_AUTH_MODE=apikey
# format: key:role|role,key:role  (roles: ingest analyst approver admin service)
CONVOIQ_API_KEYS=dev-ingest:ingest,dev-analyst:analyst,dev-approver:approver,dev-admin:admin,dev-svc:service
CONVOIQ_SERVICE_API_KEY=dev-svc
CONVOIQ_PII_HMAC_KEY=local-dev-hmac-key-0123456789
CONVOIQ_CONNECTOR_MODE=simulated
# LLM is optional. none = fully deterministic pipeline. vertex | anthropic need credentials.
CONVOIQ_LLM_PROVIDER=none
# CONVOIQ_LLM_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
